{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "commit", "executed_at", "validator", "release", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "executed_at": {"type": "string", "minLength": 1},
    "validator": {"type": "string", "const": "madva-ha-disruption"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "kubernetes_version", "node_count", "replicas_expected"],
      "properties": {
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kubernetes_version": {"type": "string", "pattern": "^[a-zA-Z0-9._+-]+$", "minLength": 1},
        "node_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "replicas_expected": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors", "checks", "tests"],
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}},
        "checks": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}},
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "replicas_available", "audit_chain_valid", "sensitive_values_exposed"],
            "properties": {
              "name": {"enum": ["pod_delete", "node_drain", "rolling_update", "audit_dependency_outage", "otlp_dependency_outage", "shared_storage_restore"]},
              "status": {"enum": ["pass", "fail", "not_run"]},
              "replicas_available": {"type": "integer", "minimum": 0, "maximum": 100},
              "requests_total": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "requests_failed": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "p95_latency_ms": {"type": "number", "minimum": 0, "maximum": 3600000},
              "audit_receipts_verified": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "audit_chain_valid": {"type": "boolean"},
              "sensitive_values_exposed": {"type": "boolean"},
              "findings": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}}
            }
          }
        }
      }
    }
  }
}

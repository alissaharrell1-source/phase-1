# Copy to .env only on a deployment host. Never commit real values.
MADVA_PRODUCTION=true

# OIDC / JWKS identity validation
MADVA_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MADVA_OIDC_ISSUER=https://identity.example.com/
MADVA_OIDC_AUDIENCE=vie-gateway

# HMAC signature for Intent Contracts; use a long random value.
MADVA_INTENT_SECRET=replace-with-random-secret

# Immutable execution image digest, never use :latest.
MADVA_RUNTIME_IMAGE=registry.example/madva-tool@sha256:replace-with-image-digest

# Optional OTLP HTTP collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional Vault KV v2 provider; leave unset to keep credential access denied.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=replace-with-short-lived-vault-token

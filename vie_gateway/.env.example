# Copy to .env only on a deployment host. Never commit real values.
MADVA_PRODUCTION=true

# OIDC / JWKS identity validation
MADVA_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MADVA_OIDC_ISSUER=https://identity.example.com/
MADVA_OIDC_AUDIENCE=vie-gateway
# Optional when the provider serves discovery from a tenant URL that differs from its advertised issuer.
# MADVA_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration

# HMAC signature for Intent Contracts; use a long random value.
MADVA_INTENT_SECRET=replace-with-random-secret

# Immutable execution image digest, never use :latest.
MADVA_RUNTIME_IMAGE=registry.example/madva-tool@sha256:replace-with-image-digest

# Durable append-only audit receipt chain.
MADVA_AUDIT_LOG_PATH=/var/lib/madva/audit/receipts.jsonl
# Writable host directory or pre-provisioned persistent volume path.
MADVA_AUDIT_HOST_PATH=C:/var/lib/madva/audit

# Require tenant_id in both the validated token and Intent Contract.
MADVA_REQUIRE_TENANT_BINDING=true

# Administrator-owned versioned policy registry. Production requires approved revisions.
MADVA_REQUIRE_APPROVED_POLICY=true
MADVA_POLICY_REGISTRY_PATH=/etc/madva/policies.json

# Optional MCP JSON-RPC upstream. The inbound MADVA token is never forwarded.
MADVA_MCP_UPSTREAM_URL=http://mcp-tool-server:9000/mcp
MADVA_MCP_UPSTREAM_ALLOWED_HOSTS=mcp-tool-server
MADVA_MCP_UPSTREAM_TIMEOUT=30
MADVA_MCP_UPSTREAM_PROTOCOL_VERSION=2026-07-28
MADVA_MCP_UPSTREAM_LIFECYCLE=stateless
MADVA_MCP_UPSTREAM_TOKEN=replace-with-upstream-token

# Optional OTLP HTTP collector/SIEM endpoint. The gateway appends /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-with-collector-token
OTEL_SERVICE_NAME=madva-vie-gateway
MADVA_SERVICE_VERSION=0.1.0
MADVA_ENVIRONMENT=production

# Optional Vault KV v2 provider; leave unset to keep credential access denied.
# Prefer a short-lived token file supplied by Vault Agent or an external secret manager.
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN_FILE=/var/run/secrets/madva/vault-token
VAULT_NAMESPACE=replace-with-vault-namespace
